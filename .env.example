# 必填：OpenAI 兼容接口的 Bearer Key（后台管理不再使用此 Key）
MUSE2API_KEY=m2a_replace_with_a_long_random_secret
# 必填：后台单管理员账号；密码至少 8 个字符
MUSE2API_ADMIN_USERNAME=admin
MUSE2API_ADMIN_PASSWORD=replace_with_a_strong_admin_password
# 必填：32 字节随机值的 base64；可用 openssl rand -base64 32 生成。丢失后无法解密账号。
MUSE2API_CREDENTIAL_KEY=replace_with_base64_encoded_32_byte_key
# 生产推荐：使用 Docker secrets 时只设置 *_FILE，文件内容优先于上面的直连值，
# 避免密钥出现在 docker inspect 和容器环境变量中。
# MUSE2API_KEY_FILE=/run/secrets/muse2api_key
# MUSE2API_ADMIN_PASSWORD_FILE=/run/secrets/muse2api_admin_password
# MUSE2API_CREDENTIAL_KEY_FILE=/run/secrets/muse2api_credential_key

MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610
MUSE2API_BIND=127.0.0.1
MUSE2API_PUBLIC_BASE=
MUSE2API_SESSION_TTL=43200
# 仅当服务位于可信反向代理之后时设为 1，用于读取 X-Real-IP / X-Forwarded-For / X-Forwarded-Proto
MUSE2API_TRUST_PROXY=0
# 迁移后是否保留旧版明文 accounts.json；默认 0 会脱敏旧文件，回滚请使用升级前备份
MUSE2API_KEEP_LEGACY_PLAINTEXT=0
MUSE2API_CONCURRENCY=2
MUSE2API_QUEUE_SIZE=64
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_HTTP_TIMEOUT=20
MUSE2API_MAX_UPLOAD_BYTES=16777216
MUSE2API_MAX_MEDIA_BYTES=536870912
# 仅开发环境；允许无加密密钥的明文凭据。生产必须保持 0。
MUSE2API_ALLOW_INSECURE_CREDENTIALS=0
MUSE2API_SITE=https://muse.ai
MUSE2API_CORS_ORIGINS=
MUSE2API_PUBLIC_MEDIA=0
MUSE2API_PROXY=
# 如代理 URL 含凭据，也可改用文件：MUSE2API_PROXY_FILE=/run/secrets/muse2api_proxy
MUSE2API_LOG_LEVEL=info
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0
# Go 通过本机回环 CDP 驱动 Chromium；0 可显式降级为仅管理/Session。
MUSE2API_BROWSER=1
# 本机可留空自动探测；Linux 容器固定为 /usr/bin/chromium。
MUSE2API_CHROMIUM=
MUSE2API_CDP_PORT=19210
MUSE2API_LOGIN_WAIT=60
MUSE2API_PROFILE_ROOT=
# 默认 data/chromium/generate；容器内必须位于可写卷。
MUSE2API_PROFILE_DIR=
MUSE2API_DOWNLOAD_DIR=
# Linux Docker 宿主机 UID/GID；默认镜像用户 10001。修改后需同步 data 目录所有者。
MUSE2API_UID=10001
MUSE2API_GID=10001
TZ=Asia/Shanghai
