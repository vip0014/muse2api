[Unit]
Description=Muse2API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muse
Group=muse
WorkingDirectory=/opt/muse2api
Environment=MUSE2API_HOME=/opt/muse2api
Environment=HOME=/opt/muse2api/data/chromium
ExecStart=/opt/muse2api/bin/muse2api
Restart=on-failure
RestartSec=5
TimeoutStopSec=45s
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/muse2api/data

[Install]
WantedBy=multi-user.target
